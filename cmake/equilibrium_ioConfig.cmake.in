@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT equilibrium_io_FIND_COMPONENTS)
  set(equilibrium_io_FIND_COMPONENTS io)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/equilibrium_dataTargets.cmake")
set(equilibrium_io_data_FOUND TRUE)
if("binary" IN_LIST equilibrium_io_FIND_COMPONENTS OR "io" IN_LIST equilibrium_io_FIND_COMPONENTS)
  include("${CMAKE_CURRENT_LIST_DIR}/equilibrium_binaryTargets.cmake")
  set(equilibrium_io_binary_FOUND TRUE)
endif()
if("io" IN_LIST equilibrium_io_FIND_COMPONENTS)
  if(@EQUILIBRIUM_HAVE_NETCDF@)
    if(@EQUILIBRIUM_NETCDF_PKGCONFIG@)
      find_dependency(PkgConfig)
      pkg_check_modules(equilibrium_netcdf REQUIRED IMPORTED_TARGET netcdf)
    else()
      find_dependency(netCDF)
    endif()
  endif()
  if(@EQUILIBRIUM_HAVE_HDF5@)
    find_dependency(HDF5 COMPONENTS C)
  endif()
  include("${CMAKE_CURRENT_LIST_DIR}/equilibrium_ioTargets.cmake")
  set(equilibrium_io_io_FOUND TRUE)
endif()
check_required_components(equilibrium_io)
