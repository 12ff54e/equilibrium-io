include_guard(GLOBAL)
include(${CMAKE_CURRENT_LIST_DIR}/EquilibriumTargets.cmake)

# Unshared CPU modules use native Wasm exceptions. A caller may separately
# compile the binary codec with pthreads for its solver.
function(equilibrium_wasm_options target)
  foreach(property IN ITEMS COMPILE_OPTIONS LINK_OPTIONS)
    get_target_property(options ${target} ${property})
    if(options)
      list(REMOVE_ITEM options -pthread -fexceptions)
      set_property(TARGET ${target} PROPERTY ${property} "${options}")
    endif()
  endforeach()
  target_compile_options(${target} PRIVATE -fwasm-exceptions)
endfunction()

function(equilibrium_wasm_files target)
  target_sources(${target} PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../wasm/files.cpp)
  target_link_options(${target} PRIVATE -sWASMFS=1)
endfunction()

function(equilibrium_wasm_module target)
  equilibrium_wasm_options(${target})
  set_target_properties(${target} PROPERTIES SUFFIX ".wasm")
  target_link_options(${target} PRIVATE
    -fwasm-exceptions -sSTANDALONE_WASM=1 --no-entry
    -sALLOW_MEMORY_GROWTH=1 "-sEXPORTED_FUNCTIONS=['_malloc','_free']")
  equilibrium_wasm_files(${target})
endfunction()

# Build a converter with pinned scientific codecs, without a solver or a
# coordinate-transform library. All paths are relative to this library.
function(equilibrium_add_wasm_converter target)
  if(NOT EMSCRIPTEN)
    message(FATAL_ERROR "The Wasm converter requires Emscripten")
  endif()
  cmake_parse_arguments(PARSE_ARGV 1 options "TESTS" "" "")
  if(options_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown Wasm converter arguments: ${options_UNPARSED_ARGUMENTS}")
  endif()
  set(root ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..)
  set(io_target equilibrium_wasm_io)
  if(TARGET equilibrium_io AND TARGET equilibrium_wasm_codecs)
    get_target_property(has_netcdf equilibrium_io EQUILIBRIUM_HAVE_NETCDF)
    get_target_property(has_hdf5 equilibrium_io EQUILIBRIUM_HAVE_HDF5)
    if(has_netcdf AND has_hdf5)
      set(io_target equilibrium_io)
    endif()
  endif()
  if(NOT TARGET ${io_target})
    if(NOT TARGET equilibrium_wasm_codecs)
      include(${CMAKE_CURRENT_FUNCTION_LIST_DIR}/scientific_io.cmake)
    endif()
    equilibrium_add_binary_library(equilibrium_wasm_binary)
    equilibrium_wasm_options(equilibrium_wasm_binary)
    equilibrium_add_io_library(equilibrium_wasm_io equilibrium_wasm_binary
      NETCDF_TARGET equilibrium_wasm_codecs HDF5_TARGET equilibrium_wasm_codecs)
    equilibrium_wasm_options(equilibrium_wasm_io)
  endif()
  add_executable(${target} ${root}/wasm/convert.cpp)
  target_link_libraries(${target} PRIVATE ${io_target})
  equilibrium_wasm_module(${target})
  # Full NetCDF-4 metadata reads exceed Emscripten's default 64 KiB stack.
  target_link_options(${target} PRIVATE -Oz -sSTACK_SIZE=1048576)
  add_dependencies(${target} equilibrium_wasm_notices)
  get_target_property(notices equilibrium_wasm_codecs EQUILIBRIUM_LICENSE_FILES)
  set_property(TARGET ${target} PROPERTY EQUILIBRIUM_LICENSE_FILES "${notices}")
  if(options_TESTS)
    find_program(EQUILIBRIUM_NODE NAMES node nodejs REQUIRED)
    add_executable(${target}_fixture ${root}/tests/wasm_formats_fixture.cpp)
    target_link_libraries(${target}_fixture PRIVATE ${io_target} equilibrium_wasm_codecs)
    equilibrium_wasm_module(${target}_fixture)
    target_link_options(${target}_fixture PRIVATE -sSTACK_SIZE=1048576)
    add_test(NAME ${target}_conversion
      COMMAND ${EQUILIBRIUM_NODE} ${root}/tests/test_wasm_formats.mjs
        $<TARGET_FILE:${target}_fixture> $<TARGET_FILE:${target}>)
    set_tests_properties(${target}_conversion PROPERTIES LABELS "unit;io;wasm")
  endif()
endfunction()
