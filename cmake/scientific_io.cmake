# Keep the serial file libraries outside the solver's pthread build. Only the
# on-demand formats module links these Emscripten archives.
include(ExternalProject)
if(POLICY CMP0135)
  cmake_policy(SET CMP0135 NEW)
endif()

set(EQUILIBRIUM_WASM_PREFIX ${CMAKE_CURRENT_BINARY_DIR}/scientific-io)
set(EQUILIBRIUM_WASM_INSTALL ${EQUILIBRIUM_WASM_PREFIX}/install)
file(MAKE_DIRECTORY ${EQUILIBRIUM_WASM_INSTALL}/include ${EQUILIBRIUM_WASM_INSTALL}/lib)
set(EQUILIBRIUM_WASM_CMAKE_ARGS
  -DCMAKE_TOOLCHAIN_FILE:FILEPATH=${CMAKE_TOOLCHAIN_FILE}
  -DCMAKE_BUILD_TYPE:STRING=MinSizeRel
  -DCMAKE_INSTALL_PREFIX:PATH=${EQUILIBRIUM_WASM_INSTALL}
  -DCMAKE_INSTALL_LIBDIR:STRING=lib
  -DCMAKE_C_FLAGS:STRING=-ffunction-sections\ -fdata-sections
  -DBUILD_SHARED_LIBS:BOOL=OFF)

ExternalProject_Add(equilibrium_wasm_zlib
  PREFIX ${EQUILIBRIUM_WASM_PREFIX}/zlib
  URL https://zlib.net/fossils/zlib-1.3.1.tar.gz
  URL_HASH SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
  CMAKE_ARGS ${EQUILIBRIUM_WASM_CMAKE_ARGS} -DZLIB_BUILD_EXAMPLES:BOOL=OFF
  BUILD_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --target zlibstatic
  INSTALL_COMMAND ${CMAKE_COMMAND} -E copy_if_different
    <BINARY_DIR>/libz.a ${EQUILIBRIUM_WASM_INSTALL}/lib/libz.a
  COMMAND ${CMAKE_COMMAND} -E copy_if_different
    <SOURCE_DIR>/zlib.h <BINARY_DIR>/zconf.h ${EQUILIBRIUM_WASM_INSTALL}/include
  BUILD_BYPRODUCTS ${EQUILIBRIUM_WASM_INSTALL}/lib/libz.a)

ExternalProject_Add(equilibrium_wasm_hdf5
  PREFIX ${EQUILIBRIUM_WASM_PREFIX}/hdf5
  URL https://codeload.github.com/HDFGroup/hdf5/tar.gz/refs/tags/hdf5_1.14.6
  URL_HASH SHA256=09ee1c671a87401a5201c06106650f62badeea5a3b3941e9b1e2e1e08317357f
  DEPENDS equilibrium_wasm_zlib
  CMAKE_ARGS ${EQUILIBRIUM_WASM_CMAKE_ARGS}
    # Wasm has no floating-point exception flags (FE_ALL_EXCEPT is zero).
    # HDF5 1.14.6 clears FE_INVALID unconditionally during type setup.
    -DCMAKE_C_FLAGS:STRING=-ffunction-sections\ -fdata-sections\ -DFE_INVALID=0
    -DBUILD_STATIC_LIBS:BOOL=ON -DBUILD_TESTING:BOOL=OFF
    -DHDF5_BUILD_HL_LIB:BOOL=ON -DHDF5_BUILD_CPP_LIB:BOOL=OFF
    -DHDF5_BUILD_FORTRAN:BOOL=OFF -DHDF5_BUILD_JAVA:BOOL=OFF
    -DHDF5_BUILD_TOOLS:BOOL=OFF -DHDF5_BUILD_UTILS:BOOL=OFF
    -DHDF5_BUILD_EXAMPLES:BOOL=OFF
    -DHDF5_BUILD_DOC:BOOL=OFF -DHDF5_ENABLE_PARALLEL:BOOL=OFF
    -DHDF5_ENABLE_THREADSAFE:BOOL=OFF -DHDF5_ENABLE_SZIP_SUPPORT:BOOL=OFF
    -DHDF5_ENABLE_Z_LIB_SUPPORT:BOOL=ON -DHDF5_ENABLE_PLUGIN_SUPPORT:BOOL=OFF
    -DHDF5_ENABLE_NONSTANDARD_FEATURE_FLOAT16:BOOL=OFF
    -DZLIB_LIBRARY:FILEPATH=${EQUILIBRIUM_WASM_INSTALL}/lib/libz.a
    -DZLIB_INCLUDE_DIR:PATH=${EQUILIBRIUM_WASM_INSTALL}/include
  BUILD_BYPRODUCTS ${EQUILIBRIUM_WASM_INSTALL}/lib/libhdf5.a
    ${EQUILIBRIUM_WASM_INSTALL}/lib/libhdf5_hl.a)

ExternalProject_Add(equilibrium_wasm_netcdf
  PREFIX ${EQUILIBRIUM_WASM_PREFIX}/netcdf
  URL https://codeload.github.com/Unidata/netcdf-c/tar.gz/refs/tags/v4.9.3
  URL_HASH SHA256=990f46d49525d6ab5dc4249f8684c6deeaf54de6fec63a187e9fb382cc0ffdff
  DEPENDS equilibrium_wasm_hdf5
  CMAKE_ARGS ${EQUILIBRIUM_WASM_CMAKE_ARGS}
    -DCMAKE_PROJECT_netCDF_INCLUDE:FILEPATH=${CMAKE_CURRENT_LIST_DIR}/netcdf_dependencies.cmake
    -DCMAKE_PREFIX_PATH:PATH=${EQUILIBRIUM_WASM_INSTALL}
    -DHDF5_ROOT:PATH=${EQUILIBRIUM_WASM_INSTALL} -DHDF5_USE_STATIC_LIBRARIES:BOOL=ON
    -DHDF5_DIR:PATH=${EQUILIBRIUM_WASM_INSTALL}/cmake
    -DZLIB_LIBRARY:FILEPATH=${EQUILIBRIUM_WASM_INSTALL}/lib/libz.a
    -DZLIB_INCLUDE_DIR:PATH=${EQUILIBRIUM_WASM_INSTALL}/include
    -DNETCDF_ENABLE_HDF5:BOOL=ON -DNETCDF_FIND_SHARED_LIBS:BOOL=OFF
    -DNETCDF_ENABLE_DAP:BOOL=OFF -DNETCDF_ENABLE_NCZARR:BOOL=OFF
    -DNETCDF_ENABLE_REMOTE_FUNCTIONALITY:BOOL=OFF
    -DNETCDF_ENABLE_BYTERANGE:BOOL=OFF -DNETCDF_ENABLE_HDF4:BOOL=OFF
    -DNETCDF_ENABLE_PARALLEL4:BOOL=OFF -DNETCDF_ENABLE_PNETCDF:BOOL=OFF
    -DNETCDF_ENABLE_PLUGINS:BOOL=OFF -DNETCDF_PLUGIN_INSTALL:BOOL=OFF
    -DNETCDF_ENABLE_FILTER_SZIP:BOOL=OFF -DNETCDF_ENABLE_FILTER_BZ2:BOOL=OFF
    -DNETCDF_ENABLE_FILTER_BLOSC:BOOL=OFF -DNETCDF_ENABLE_FILTER_ZSTD:BOOL=OFF
    -DNETCDF_ENABLE_NCZARR_ZIP:BOOL=OFF -DNETCDF_ENABLE_LIBXML2:BOOL=OFF
    -DNETCDF_ENABLE_MMAP:BOOL=OFF -DNETCDF_ENABLE_V2_API:BOOL=OFF
    -DNETCDF_BUILD_UTILITIES:BOOL=OFF -DNETCDF_ENABLE_EXAMPLES:BOOL=OFF
    -DNETCDF_ENABLE_TESTS:BOOL=OFF -DNETCDF_ENABLE_DOXYGEN:BOOL=OFF
    -DNETCDF_PACKAGE:BOOL=OFF
  BUILD_BYPRODUCTS ${EQUILIBRIUM_WASM_INSTALL}/lib/libnetcdf.a)
ExternalProject_Add_StepDependencies(equilibrium_wasm_netcdf configure
  ${CMAKE_CURRENT_LIST_DIR}/netcdf_dependencies.cmake)

add_library(equilibrium_wasm_codecs INTERFACE)
add_dependencies(equilibrium_wasm_codecs equilibrium_wasm_netcdf)
target_include_directories(equilibrium_wasm_codecs SYSTEM INTERFACE ${EQUILIBRIUM_WASM_INSTALL}/include)
target_link_libraries(equilibrium_wasm_codecs INTERFACE
  ${EQUILIBRIUM_WASM_INSTALL}/lib/libnetcdf.a
  ${EQUILIBRIUM_WASM_INSTALL}/lib/libhdf5_hl.a
  ${EQUILIBRIUM_WASM_INSTALL}/lib/libhdf5.a
  ${EQUILIBRIUM_WASM_INSTALL}/lib/libz.a)

foreach(library IN ITEMS zlib hdf5 netcdf)
  ExternalProject_Get_Property(equilibrium_wasm_${library} SOURCE_DIR)
  set(EQUILIBRIUM_WASM_${library}_SOURCE ${SOURCE_DIR})
endforeach()
set(EQUILIBRIUM_WASM_NOTICES
  ${CMAKE_CURRENT_BINARY_DIR}/licenses/HDF5.txt
  ${CMAKE_CURRENT_BINARY_DIR}/licenses/HDF5-LBNL.txt
  ${CMAKE_CURRENT_BINARY_DIR}/licenses/netCDF-C.txt
  ${CMAKE_CURRENT_BINARY_DIR}/licenses/netCDF-utf8proc.txt
  ${CMAKE_CURRENT_BINARY_DIR}/licenses/zlib.txt)
ExternalProject_Get_Property(equilibrium_wasm_netcdf STAMP_DIR)
set(EQUILIBRIUM_WASM_NOTICES_STAMP ${CMAKE_CURRENT_BINARY_DIR}/licenses/notices.stamp)
add_custom_command(OUTPUT ${EQUILIBRIUM_WASM_NOTICES_STAMP}
  BYPRODUCTS ${EQUILIBRIUM_WASM_NOTICES}
  COMMAND ${CMAKE_COMMAND} -E make_directory ${CMAKE_CURRENT_BINARY_DIR}/licenses
  COMMAND ${CMAKE_COMMAND} -E copy_if_different
    ${EQUILIBRIUM_WASM_hdf5_SOURCE}/COPYING ${CMAKE_CURRENT_BINARY_DIR}/licenses/HDF5.txt
  COMMAND ${CMAKE_COMMAND} -E copy_if_different
    ${EQUILIBRIUM_WASM_hdf5_SOURCE}/COPYING_LBNL_HDF5 ${CMAKE_CURRENT_BINARY_DIR}/licenses/HDF5-LBNL.txt
  COMMAND ${CMAKE_COMMAND} -E copy_if_different
    ${EQUILIBRIUM_WASM_netcdf_SOURCE}/COPYRIGHT ${CMAKE_CURRENT_BINARY_DIR}/licenses/netCDF-C.txt
  COMMAND ${CMAKE_COMMAND}
    -DSOURCE=${EQUILIBRIUM_WASM_netcdf_SOURCE}/libdispatch/utf8proc.h
    -DOUTPUT=${CMAKE_CURRENT_BINARY_DIR}/licenses/netCDF-utf8proc.txt
    -P ${CMAKE_CURRENT_LIST_DIR}/utf8proc_notice.cmake
  COMMAND ${CMAKE_COMMAND} -E copy_if_different
    ${EQUILIBRIUM_WASM_zlib_SOURCE}/README ${CMAKE_CURRENT_BINARY_DIR}/licenses/zlib.txt
  COMMAND ${CMAKE_COMMAND} -E touch ${EQUILIBRIUM_WASM_NOTICES_STAMP}
  DEPENDS equilibrium_wasm_netcdf ${STAMP_DIR}/equilibrium_wasm_netcdf-install
          ${CMAKE_CURRENT_LIST_FILE} ${CMAKE_CURRENT_LIST_DIR}/utf8proc_notice.cmake
  COMMENT "Bundling scientific I/O license notices from pinned sources"
  VERBATIM)
add_custom_target(equilibrium_wasm_notices DEPENDS ${EQUILIBRIUM_WASM_NOTICES_STAMP})

set_property(TARGET equilibrium_wasm_codecs PROPERTY EQUILIBRIUM_LICENSE_FILES "${EQUILIBRIUM_WASM_NOTICES}")
